# Tang Primer / Anlogic EG4S20 synthesis.
#
# Run from the repository root after build/sw/testrom/main.hex exists.
# The slang frontend handles the SystemVerilog packages, structs, enums and
# assignment patterns used by the J2 RTL.  -noflatten keeps the hierarchy
# intact and substantially reduces synthesis runtime on Yosys 0.70.

read_slang --std 1800-2017 --no-proc --top j2_tang_primer \
  -G PROGRAM_FILE="build/sw/testrom/main.hex" \
  rtl/pkg/j2_cpu_pkg.sv \
  rtl/pkg/j2_decode_pkg.sv \
  rtl/pkg/j2_alu_pkg.sv \
  rtl/pkg/j2_wb_pkg.sv \
  rtl/pkg/j2_isa_pkg.sv \
  rtl/core/j2_decode_table.sv \
  rtl/core/j2_decode_core.sv \
  rtl/core/j2_decode.sv \
  rtl/core/j2_regfile.sv \
  rtl/core/j2_mult.sv \
  rtl/core/j2_sr.sv \
  rtl/core/j2_dbus_wbm.sv \
  rtl/core/j2_ibus_wbm.sv \
  rtl/core/j2_debug.sv \
  rtl/core/j2_datapath.sv \
  rtl/core/j2_cpu.sv \
  rtl/wb/j2_wb_decoder.sv \
  rtl/wb/j2_wb_sram.sv \
  rtl/periph/j2_pio.sv \
  rtl/periph/j2_spi.sv \
  rtl/periph/j2_cache_ctrl.sv \
  rtl/periph/j2_uartlite.sv \
  rtl/periph/j2_aic.sv \
  rtl/periph/j2_periph.sv \
  rtl/soc/j2_soc.sv \
  rtl/fpga/j2_tang_primer.sv

synth_anlogic -noflatten -top j2_tang_primer \
  -json build/fpga/j2_tang_primer.json \
  -edif build/fpga/j2_tang_primer.edf

write_verilog -noattr -noexpr build/fpga/j2_tang_primer.v
stat
