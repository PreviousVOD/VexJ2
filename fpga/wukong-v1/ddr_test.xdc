# DDR3 pad locations/IO standards are supplied by the generated MIG constraints.
set_property PACKAGE_PIN M22 [get_ports clk50]
set_property PACKAGE_PIN H7 [get_ports reset_n]
set_property PACKAGE_PIN E3 [get_ports uart_tx]
set_property PACKAGE_PIN J6 [get_ports {led_n[0]}]
set_property PACKAGE_PIN H6 [get_ports {led_n[1]}]
set_property PACKAGE_PIN H4 [get_ports flash_cs_n]
set_property IOSTANDARD LVCMOS33 [get_ports {clk50 reset_n uart_tx led_n[*] flash_cs_n}]
set_property PULLUP TRUE [get_ports {reset_n flash_cs_n}]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
create_clock -name board_clk -period 20.000 [get_ports clk50]
set_false_path -from [get_ports reset_n]
