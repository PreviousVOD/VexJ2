# QMTECH Wukong v1 schematic, pages 2 and 4. DDR pins/IO standards are supplied by MIG.
set_property PACKAGE_PIN M22 [get_ports clk50]
set_property PACKAGE_PIN H7 [get_ports reset_n]
set_property PACKAGE_PIN F3 [get_ports uart_rx]
set_property PACKAGE_PIN E3 [get_ports uart_tx]
set_property PACKAGE_PIN J6 [get_ports {led_n[0]}]
set_property PACKAGE_PIN H6 [get_ports {led_n[1]}]
# J11 / SF3: pins 1 CS, 2 DQ0, 3 DQ1, 4 SCK, 9 DQ2, 10 DQ3.
set_property PACKAGE_PIN H4 [get_ports flash_cs_n]
set_property PACKAGE_PIN F4 [get_ports {flash_dq[0]}]
set_property PACKAGE_PIN A4 [get_ports {flash_dq[1]}]
set_property PACKAGE_PIN A5 [get_ports flash_clk]
set_property PACKAGE_PIN B4 [get_ports {flash_dq[2]}]
set_property PACKAGE_PIN B5 [get_ports {flash_dq[3]}]
# GPIO pads 0..15: JP2; 16..23: J10 (software bits 24..31).
set_property PACKAGE_PIN H21 [get_ports {gpio[0]}]
set_property PACKAGE_PIN H22 [get_ports {gpio[1]}]
set_property PACKAGE_PIN K21 [get_ports {gpio[2]}]
set_property PACKAGE_PIN J21 [get_ports {gpio[3]}]
set_property PACKAGE_PIN J26 [get_ports {gpio[4]}]
set_property PACKAGE_PIN H26 [get_ports {gpio[5]}]
set_property PACKAGE_PIN G25 [get_ports {gpio[6]}]
set_property PACKAGE_PIN F25 [get_ports {gpio[7]}]
set_property PACKAGE_PIN G20 [get_ports {gpio[8]}]
set_property PACKAGE_PIN G21 [get_ports {gpio[9]}]
set_property PACKAGE_PIN F23 [get_ports {gpio[10]}]
set_property PACKAGE_PIN E23 [get_ports {gpio[11]}]
set_property PACKAGE_PIN E26 [get_ports {gpio[12]}]
set_property PACKAGE_PIN D26 [get_ports {gpio[13]}]
set_property PACKAGE_PIN E25 [get_ports {gpio[14]}]
set_property PACKAGE_PIN D25 [get_ports {gpio[15]}]
set_property PACKAGE_PIN D5 [get_ports {gpio[16]}]
set_property PACKAGE_PIN E5 [get_ports {gpio[17]}]
set_property PACKAGE_PIN G5 [get_ports {gpio[18]}]
set_property PACKAGE_PIN E6 [get_ports {gpio[19]}]
set_property PACKAGE_PIN G7 [get_ports {gpio[20]}]
set_property PACKAGE_PIN D6 [get_ports {gpio[21]}]
set_property PACKAGE_PIN G8 [get_ports {gpio[22]}]
set_property PACKAGE_PIN G6 [get_ports {gpio[23]}]
set_property IOSTANDARD LVCMOS33 [get_ports -filter {NAME !~ ddr3_*}]
set_property PULLUP TRUE [get_ports {reset_n uart_rx flash_cs_n flash_dq[2] flash_dq[3]}]
set_property DRIVE 8 [get_ports {uart_tx led_n[*] gpio[*] flash_cs_n flash_clk flash_dq[*]}]
set_property SLEW SLOW [get_ports {uart_tx led_n[*] gpio[*] flash_cs_n flash_clk flash_dq[*]}]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
create_clock -name board_clk -period $board_clock_period [get_ports clk50]
# Button and UART input are asynchronous; reset and UART implement synchronization.
set_false_path -from [get_ports {reset_n uart_rx}]
# External GPIO/SPI timing is not signed off by the step-1 synthesis target.
